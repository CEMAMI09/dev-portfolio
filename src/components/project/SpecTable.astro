---
/**
 * Small technical table. With `columns` it renders a headed table; without,
 * a two-column label / value table. `disclaimer` is printed prominently and
 * is how modeled, targeted, or design-stage numbers are labelled as such.
 */
interface Props {
  title: string;
  rows: string[][];
  columns?: string[];
  caption?: string;
  disclaimer?: string;
  id?: string;
  class?: string;
}

const { title, rows, columns, caption, disclaimer, id, class: className } = Astro.props;
const captionId = id ? `${id}-caption` : undefined;
---

<div class:list={['spec', className]} id={id}>
  <div class="spec__bar">
    <span class="spec__title">{title}</span>
    {disclaimer && <span class="spec__disclaimer">{disclaimer}</span>}
  </div>
  <table class="spec__table" aria-describedby={captionId}>
    {
      columns && (
        <thead>
          <tr>
            {columns.map((c) => (
              <th scope="col">{c}</th>
            ))}
          </tr>
        </thead>
      )
    }
    <tbody>
      {
        rows.map((row) => (
          <tr>
            {row.map((cell, i) =>
              i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>,
            )}
          </tr>
        ))
      }
    </tbody>
  </table>
  {caption && <p class="spec__caption" id={captionId}>{caption}</p>}
</div>

<style>
  .spec {
    border: var(--line) solid var(--border);
    border-radius: var(--radius);
    background: var(--panel);
    min-width: 0;
  }

  /* Title on the first line, disclaimer (if any) on its own line beneath so
     tables placed side by side line up. */
  .spec__bar {
    display: grid;
    justify-items: start;
    gap: var(--s-2);
    padding: var(--s-2) var(--s-3);
    border-bottom: var(--line) solid var(--border);
    background: var(--bg-raised);
  }

  .spec__title,
  .spec__disclaimer {
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    letter-spacing: var(--track-mono-wide);
    text-transform: uppercase;
    line-height: 1.3;
  }

  .spec__title {
    font-weight: 500;
    color: var(--text);
  }

  .spec__disclaimer {
    color: var(--text);
    border: var(--line) solid var(--text-2);
    padding: 0.2rem 0.45rem;
    border-radius: var(--radius);
  }

  .spec__table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    line-height: 1.45;
  }

  .spec__table th,
  .spec__table td {
    text-align: left;
    vertical-align: top;
    padding: var(--s-2) var(--s-3);
    border-bottom: var(--line) solid var(--border-2);
    font-weight: 400;
  }

  .spec__table thead th {
    font-size: var(--fs-2xs);
    font-weight: 500;
    letter-spacing: var(--track-mono);
    text-transform: uppercase;
    color: var(--text-3);
  }

  .spec__table tbody th {
    color: var(--text-2);
    width: 40%;
  }

  .spec__table td {
    color: var(--text);
  }

  .spec__table tbody tr:last-child th,
  .spec__table tbody tr:last-child td {
    border-bottom: 0;
  }

  .spec__caption {
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    color: var(--text-3);
    line-height: 1.5;
    padding: var(--s-2) var(--s-3);
    border-top: var(--line) solid var(--border-2);
    max-width: none;
  }

  @media (max-width: 420px) {
    .spec__table {
      font-size: var(--fs-xs);
    }

    .spec__table tbody th {
      width: 45%;
    }
  }
</style>
