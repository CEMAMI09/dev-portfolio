---
/**
 * Monochrome technology tags. Only used attached to a specific project or job.
 */
interface Props {
  items: readonly string[];
  /** Accessible name for the list. */
  label?: string;
  size?: 'sm' | 'md';
}

const { items, label = 'Technologies', size = 'sm' } = Astro.props;
---

<ul class:list={['tags', `tags--${size}`]} role="list" aria-label={label}>
  {items.map((item) => <li class="tags__item">{item}</li>)}
</ul>

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }

  .tags__item {
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    letter-spacing: var(--track-mono);
    text-transform: uppercase;
    line-height: 1;
    color: var(--text-2);
    border: var(--line) solid var(--border);
    border-radius: var(--radius);
    padding: 0.4rem 0.5rem;
    white-space: nowrap;
  }

  .tags--md .tags__item {
    font-size: var(--fs-xs);
    padding: 0.5rem 0.625rem;
  }
</style>
