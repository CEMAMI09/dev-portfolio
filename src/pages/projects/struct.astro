---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectHeader from '../../components/project/ProjectHeader.astro';
import Contents from '../../components/project/Contents.astro';
import CaseStudySection from '../../components/project/CaseStudySection.astro';
import ArchitectureDiagram from '../../components/project/ArchitectureDiagram.astro';
import FeatureList from '../../components/project/FeatureList.astro';
import Notes from '../../components/project/Notes.astro';
import SpecTable from '../../components/project/SpecTable.astro';
import ProjectGallery from '../../components/project/ProjectGallery.astro';
import ProjectNav from '../../components/project/ProjectNav.astro';
import ImageFrame from '../../components/ui/ImageFrame.astro';
import TechTags from '../../components/ui/TechTags.astro';
import StatusLabel from '../../components/ui/StatusLabel.astro';
import ExternalLink from '../../components/ui/ExternalLink.astro';

const project = await getEntry('projects', 'struct');
if (!project) throw new Error('Missing content entry: projects/struct');
const { data } = project;
const { Content, headings } = await render(project);

const table = (id: string) => {
  const t = data.tables.find((x) => x.id === id);
  if (!t) throw new Error(`struct: missing table "${id}"`);
  return t;
};
const diagram = (id: string) => {
  const d = data.diagrams.find((x) => x.id === id);
  if (!d) throw new Error(`struct: missing diagram "${id}"`);
  return d;
};

const sections = [
  { id: 'why', index: '01', title: 'Why it exists' },
  { id: 'overview', index: '02', title: 'System overview' },
  { id: 'built', index: '03', title: 'What I built' },
  { id: 'engineering', index: '04', title: 'Engineering notes' },
  { id: 'bandwidth', index: '05', title: 'Modeled bandwidth' },
  { id: 'stack', index: '06', title: 'Technologies' },
  { id: 'status', index: '07', title: 'Status' },
  { id: 'gallery', index: '08', title: 'Gallery' },
];
const featureCount = data.features.reduce((n, g) => n + g.items.length, 0);
---

<BaseLayout
  title={data.seo.title}
  bareTitle
  description={data.seo.description}
  crumbs={[{ label: 'projects', href: '/projects' }, { label: project.id }]}
  pathMeta={`Status: ${data.status.label}`}
  ogType="article"
>
  <ProjectHeader project={project} />

  <div class="container hero">
    <ImageFrame image={data.hero} loading="eager" sizes="(max-width: 1240px) 100vw, 1200px" />
  </div>

  <Contents items={sections} />

  <CaseStudySection id="why" index="01" title="Why it exists">
    <p class="prose lede">{data.why}</p>
  </CaseStudySection>

  <CaseStudySection id="overview" index="02" title="System overview">
    <ArchitectureDiagram
      title={diagram('dataflow').title}
      steps={diagram('dataflow').steps}
      direction={diagram('dataflow').direction}
      caption={diagram('dataflow').caption}
      numbered
    />
    <div class="overview-notes">
      <div>
        <p class="label">Device side</p>
        <p class="prose">
          Firmware packs a struct, wraps it in a Protocol v2 frame, and sends it over TCP or UDP.
          No TLS handshake, no JSON, no HTTP headers.
        </p>
      </div>
      <div>
        <p class="label">Gateway side</p>
        <p class="prose">
          The gateway checks the HMAC and nonce, resolves the schema version named in the frame,
          stores the decoded telemetry, and forwards it as signed JSON to the destinations the
          organization configured.
        </p>
      </div>
    </div>
  </CaseStudySection>

  <CaseStudySection id="built" index="03" title="What I built" meta={`${featureCount} features`}>
    <p class="prose lede">{data.built}</p>
    <div class="features">
      <FeatureList groups={data.features} />
    </div>
  </CaseStudySection>

  <CaseStudySection
    id="engineering"
    index="04"
    title="Engineering notes"
    meta={`${headings.filter((h) => h.depth === 2).length} notes`}
  >
    <Notes headings={headings}>
      <Content />
    </Notes>
  </CaseStudySection>

  <CaseStudySection id="bandwidth" index="05" title="Modeled bandwidth" meta="Estimates">
    <p class="prose">
      The point of the binary protocol is to remove the cost of a cold HTTPS connection from every
      reading. These figures are modeled from the example payload; they are not measurements from
      production customer traffic.
    </p>
    <div class="tables">
      <SpecTable {...table('bandwidth')} />
      <SpecTable {...table('fleet')} />
    </div>
  </CaseStudySection>

  <CaseStudySection id="stack" index="06" title="Technologies">
    <TechTags items={data.tech} size="md" />
    <p class="prose stack-note">
      Nuxt and Vue for the dashboard, Node.js for the TCP/UDP listeners and API, Supabase and
      PostgreSQL for storage and auth, Stripe for billing. Rust (via napi-rs) and eBPF/XDP are
      optional paths described in the notes above.
    </p>
  </CaseStudySection>

  <CaseStudySection id="status" index="07" title="Status">
    <div class="status-row">
      <StatusLabel kind={data.status.kind} label={data.status.label} />
      <p class="prose">{data.currentStatus}</p>
      {
        data.links.live && (
          <p class="mono status-link">
            <ExternalLink href={data.links.live.url}>{data.links.live.label}</ExternalLink>
            {!data.links.live.verified && <span class="dim"> — {data.links.live.note}</span>}
          </p>
        )
      }
    </div>
  </CaseStudySection>

  <CaseStudySection id="gallery" index="08" title="Gallery" meta={`${data.gallery.length} images`}>
    <ProjectGallery images={data.gallery} />
  </CaseStudySection>

  <ProjectNav currentId={project.id} sourceUrl={data.links.source.url} />
</BaseLayout>

<style>
  .hero {
    padding-bottom: var(--s-7);
  }

  .lede {
    font-size: var(--fs-lg);
    line-height: 1.5;
    color: var(--text);
    max-width: 38em;
  }

  .overview-notes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--s-6);
    margin-top: var(--s-6);
  }

  .overview-notes .label {
    margin-bottom: var(--s-2);
  }

  .features {
    margin-top: var(--s-6);
  }

  .tables {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: var(--s-4);
    margin-top: var(--s-5);
  }

  .stack-note {
    margin-top: var(--s-5);
    font-size: var(--fs-base);
  }

  .status-row {
    display: grid;
    gap: var(--s-4);
  }

  .status-link {
    color: var(--text-2);
  }
</style>
